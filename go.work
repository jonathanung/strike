// Leaf modules so a future harness module can import protocol/redact
// without a cycle through the root module. Not published; root go.mod
// require+replace keeps GOWORK=off working. Do not add git submodules.
//
// provider/ is the public Provider interface + echo (until #1208 moves
// them into harness/provider). providers/ owns adapters, auth flows, and
// the construction factory.
go 1.26.2

use (
	.
	./pkg/protocol
	./pkg/redact
	./provider
	./providers
)
