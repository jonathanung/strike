// Leaf modules so the harness module can import protocol/redact
// without a cycle through the root module. Not published; root go.mod
// require+replace keeps GOWORK=off working. Do not add git submodules.
//
// provider/ (interface + echo) lives in harness/provider (#1208).
// adapters, auth flows, and the construction factory live in
// harness/providers (#1232) — not a sibling module.
go 1.26.2

use (
	.
	./harness
	./pkg/protocol
	./pkg/redact
)
